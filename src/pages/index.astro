---
import Base from '../layouts/Base.astro';
import { person, story, sites } from '../content';
import '../styles/story.css';

const others = [{ name: 'Work', href: sites.work }, { name: 'Hire', href: sites.hire }].filter(v => v.href);
const pad = (n: number) => String(n).padStart(2, '0');

// Split each headline into lines and letters so they can flip in one by one.
const slides = story.map(s => {
  let i = 0;
  const lines = s.lines.map(raw => {
    const outline = raw.startsWith('*');
    const text = outline ? raw.slice(1) : raw;
    return { outline, text, letters: [...text].map(ch => ({ ch, i: i++ })) };
  });
  return { ...s, lines, label: lines.map(l => l.text).join(' ') };
});
---
<Base
  title={`${person.name} — Story`}
  description="Top 3% in JEE, founder at 19, and now building AI offices that run on WhatsApp. The story so far, in nine swipes."
  fonts="https://fonts.googleapis.com/css2?family=Anton&family=DM+Mono:wght@400;500&display=swap"
  theme="#0b0b0b"
>
  <div class="bars" aria-hidden="true"></div>
  <div class="top"><a href="/">@shubhraj</a><span id="count">01 / {pad(slides.length)}</span></div>
  <nav class="rail" aria-label="Contact">
    <a href={`mailto:${person.email}`} title="Email">MAIL</a>
    <a href={person.linkedin} title="LinkedIn">IN</a>
    <a href={person.github} title="GitHub">GIT</a>
  </nav>

  <main>
    {slides.map((s, n) => {
      const Tag = n === 0 ? 'h1' : 'h2';
      return (
      <section class={s.tone === 'ink' ? '' : s.tone}>
        {s.echo && (
          <div class="echo" aria-hidden="true">
            {[0, 1, 2, 3, 4, 5, 6].map(i => <span style={`--i:${i}`}>{person.first}</span>)}
          </div>
        )}
        <p class="tag">{s.tag}</p>
        <Tag class="big" aria-label={s.label}>
          {s.lines.map(l => (
            <span class:list={['line', { out: l.outline }]} aria-hidden="true">{l.letters.map(x => <span class="ch" style={`--i:${x.i}`}>{x.ch === ' ' ? '\u00a0' : x.ch}</span>)}</span>
          ))}
        </Tag>
        <div class="meta">
          {s.meta.map((m, i) => <p style={`--i:${i}`} set:html={m} />)}
        </div>
        {n === 0 && <div class="hint" aria-hidden="true">↓ SWIPE UP</div>}
        {n === slides.length - 1 && others.length > 0 && (
          <p class="others">{others.map(v => <a href={v.href}>{v.name} version</a>)}</p>
        )}
        {s.marquee && (
          <div class="marquee" aria-hidden="true"><div>{Array(8).fill(`${s.marquee} — `).join('')}</div></div>
        )}
      </section>
      );
    })}
  </main>

  <script>
    import '../scripts/reel.ts';
  </script>
</Base>
